# Secrets: never commit keys, tokens or settings files that may hold them.
.env
.env.*
*.key
*.pem
*.pfx
secrets.*
*credentials*
*token*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Build and check output
dist/
build/
freecad-load-check.txt
artifacts/

